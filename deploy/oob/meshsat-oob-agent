#!/usr/bin/env python3
"""meshsat-oob-agent: allowlisted host actions for the MeshSat bridge.

The bridge container talks to this agent over a Unix socket
(/run/meshsat-oob/agent.sock, directory bind-mounted into the container):
one JSON line request, one JSON line reply, one connection per call.

  -> {"action": "journal_tail", "args": {"unit": "docker", "lines": 10}}
  <- {"ok": true, "result": {"lines": ["..."]}, "version": "2"}
  <- {"ok": false, "error": "unknown action"}
  -> {"action": "usb_power_cycle", "args": {"device": "mesh", "tty": "/dev/ttyACM1"}}
  <- {"ok": true, "result": {"scheduled": true, "hub": "2-1", "twin": "3-1", "port": 3, ...}}

Every action is a fixed argv built from table lookups and clamped
integers. Nothing from a request is ever interpolated into a shell string
and no netplan action exists. The bridge already runs privileged, so this
allowlist is defence in depth and a declarative record of what a kit will
do on a remote command, not the security boundary. [MESHSAT-756]

Runs under systemd socket activation (meshsat-oob-agent.socket); started by
hand it binds the socket itself.
"""

import json
import os
import re
import socket
import subprocess
import sys
import time

VERSION = "2"
SOCKET_PATH = os.environ.get("MESHSAT_OOB_SOCKET", "/run/meshsat-oob/agent.sock")
READ_TIMEOUT = 5.0
MAX_LINE = 4096

# Journal units LOG may read. Mirrors internal/oob/commands.go LogUnits.
UNITS = {
    "meshsat-oob-agent": "meshsat-oob-agent.service",
    "docker": "docker.service",
    "netplan-wpa-wlan0": "netplan-wpa-wlan0.service",
    "systemd-networkd": "systemd-networkd.service",
    "x1202-monitor": "x1202-monitor.service",
    "meshsat-mgmt-keepalive": "meshsat-mgmt-keepalive.service",
    "meshsat-p2p-link": "meshsat-p2p-link.service",
    "bluetooth": "bluetooth.service",
}

# Units service_restart may restart. Deliberately short: restarting docker
# would take the bridge itself down mid-command.
RESTARTABLE = {
    "bluetooth": "bluetooth.service",
    "meshsat-p2p-link": "meshsat-p2p-link.service",
    "meshsat-mgmt-keepalive": "meshsat-mgmt-keepalive.timer",
    "x1202-monitor": "x1202-monitor.service",
}

# Wireless interfaces the wifi actions may touch.
IFACES = {"wlan0": "wlan0"}

# USB devices usb_rebind may re-enumerate through sysfs unbind/bind, by
# vendor:product. Devices whose chips are shared with other boards (CP210x,
# CH34x) are not listed: the bridge resets those by port from inside the
# container instead.
USB_REBIND = {
    "usb_wifi": ["0e8d:7612"],
    "aioc": ["1209:7388"],
    "rtl_sdr": ["0bda:2838", "0bda:2832"],
}

# USB devices usb_power_cycle may cut VBUS to, by role -> vendor:product.
# The hub port is resolved from sysfs at call time, never from a static
# port map: the bridge identifies devices by VID:PID, not by position, and
# a device replugged into another port stays valid. Shared-chip devices
# (CP210x, CH34x) are resolved from the tty the bridge claimed for the
# role, which the request carries as "tty"; the VID:PID is then only a
# sanity check. Power switching needs a hub with per-port power control
# (StarTech HB30A4AIB on the V1 kits); the Pi 5's own ports are one ganged
# VBUS group even though uhubctl labels them ppps, so root ports are
# refused. [MESHSAT-786]
USB_DEVICES = {
    "mesh": ["2886:0059"],
    "cellular": ["1a86:55d4"],
    "zigbee": ["10c4:ea60"],
    "gps": ["1546:01a7"],
    "usb_wifi": ["0e8d:7612"],
    "aioc": ["1209:7388"],
    "rtl_sdr": ["0bda:2838", "0bda:2832"],
}
USB_NAME_RE = re.compile(r"^\d+-\d+(\.\d+)*$")
USB_SYSFS = "/sys/bus/usb/devices"
DEFAULT_OFF_MS = 3000
MIN_OFF_MS = 500
MAX_OFF_MS = 10000
# The installed agent re-executes itself under systemd-run for the
# off/sleep/on sequence so the single-threaded socket loop never blocks.
AGENT_EXE = os.path.abspath(globals().get("__file__") or "/usr/local/bin/meshsat-oob-agent")

MAX_DELAY = 3600
MAX_LINES = 50


def log(msg):
    print("oob-agent: %s" % msg, flush=True)


def clamp(value, lo, hi, default):
    try:
        n = int(value)
    except (TypeError, ValueError):
        return default
    return max(lo, min(hi, n))


class Refused(Exception):
    """The request did not match the allowlist."""


def plan(action, args):
    """Turn a request into (argv, timeout, postprocess) without executing.

    argv is a list (never a string); postprocess maps the completed process
    to the result dict. Raises Refused for anything outside the allowlist.
    Pure, so it is unit-testable without root.
    """
    args = args or {}
    if action == "ping":
        return None, 1, lambda _p: {"version": VERSION}

    if action == "reboot":
        delay = clamp(args.get("delay", 10), 0, MAX_DELAY, 10)
        unit = "meshsat-oob-reboot-%d" % int(time.time())
        argv = ["systemd-run", "--collect", "--unit=" + unit,
                "--on-active=%ds" % max(delay, 1), "systemctl", "reboot"]
        return argv, 10, lambda _p: {"delay": delay}

    if action == "journal_tail":
        unit = UNITS.get(str(args.get("unit", "")))
        if unit is None:
            raise Refused("unit not allowed")
        lines = clamp(args.get("lines", 10), 1, MAX_LINES, 10)
        argv = ["journalctl", "-u", unit, "-n", str(lines), "--no-pager", "-o", "short-iso"]
        return argv, 15, lambda p: {"lines": p.stdout.splitlines()}

    if action == "net_status":
        return None, 15, lambda _p: net_status()

    if action == "wifi_reassociate":
        iface = IFACES.get(str(args.get("iface", "wlan0")))
        if iface is None:
            raise Refused("interface not allowed")
        return ["wpa_cli", "-i", iface, "reassociate"], 10, lambda p: {"output": p.stdout.strip()}

    if action == "wifi_restart":
        iface = IFACES.get(str(args.get("iface", "wlan0")))
        if iface is None:
            raise Refused("interface not allowed")
        argv = ["systemctl", "restart", "netplan-wpa-%s.service" % iface, "systemd-networkd.service"]
        return argv, 60, lambda _p: {"restarted": iface}

    if action == "p2p_restart":
        return ["systemctl", "restart", "meshsat-p2p-link.service"], 60, lambda _p: {"restarted": "meshsat-p2p-link"}

    if action == "service_restart":
        unit = RESTARTABLE.get(str(args.get("unit", "")))
        if unit is None:
            raise Refused("unit not allowed")
        return ["systemctl", "restart", unit], 60, lambda _p: {"restarted": unit}

    if action == "usb_rebind":
        ids = USB_REBIND.get(str(args.get("device", "")))
        if ids is None:
            raise Refused("device not allowed")
        return None, 20, lambda _p: usb_rebind(ids)

    if action == "usb_switchable":
        role = args.get("device")
        roles = [str(role)] if role else sorted(USB_DEVICES)
        tty = args.get("tty") if role else None
        return None, 30, lambda _p: usb_switchable(roles, tty)

    if action == "usb_power_cycle":
        role = str(args.get("device", ""))
        off_ms = clamp(args.get("off_ms", DEFAULT_OFF_MS), MIN_OFF_MS, MAX_OFF_MS, DEFAULT_OFF_MS)
        fallback = args.get("fallback", True) is not False
        dev = resolve_usb_port(role, args.get("tty"))
        if not hub_switchable(dev["hub"], dev["port"]):
            if fallback and role in USB_REBIND:
                ids = USB_REBIND[role]
                return None, 20, lambda _p: dict(usb_rebind(ids), method="rebind", name=dev["name"])
            raise Refused("hub %s has no per-port power switching" % dev["hub"])
        unit = "meshsat-usb-cycle-%s-%d" % (role, int(time.time()))
        hubs = [dev["hub"]] + ([dev["twin"]] if dev["twin"] else [])
        argv = ["systemd-run", "--collect", "--unit=" + unit,
                AGENT_EXE, "--usb-cycle", str(dev["port"]), str(off_ms)] + hubs
        result = {"scheduled": True, "method": "power_cycle", "name": dev["name"], "hub": dev["hub"],
                  "twin": dev["twin"], "port": dev["port"], "off_ms": off_ms, "unit": unit}
        return argv, 10, lambda _p: result

    raise Refused("unknown action")


def run_argv(argv, timeout):
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, check=False)


def net_status():
    """Best-effort network summary; every field is optional."""
    out = {}
    try:
        p = run_argv(["ip", "-j", "-4", "addr", "show", "wlan0"], 5)
        for iface in json.loads(p.stdout or "[]"):
            for a in iface.get("addr_info", []):
                if a.get("scope") == "global":
                    out["ip"] = a.get("local")
                    break
    except Exception as e:  # noqa: BLE001
        out["ip_err"] = str(e)[:40]
    try:
        p = run_argv(["ip", "-j", "route", "show", "default"], 5)
        out["gw"] = "Y" if json.loads(p.stdout or "[]") else "N"
    except Exception:  # noqa: BLE001
        pass
    try:
        p = run_argv(["wpa_cli", "-i", "wlan0", "status"], 5)
        for line in p.stdout.splitlines():
            if line.startswith("wpa_state="):
                out["wpa"] = line.split("=", 1)[1]
            elif line.startswith("bssid="):
                out["bssid"] = line.split("=", 1)[1]
    except Exception:  # noqa: BLE001
        pass
    try:
        p = run_argv(["iw", "dev", "wlan0", "link"], 5)
        for line in p.stdout.splitlines():
            line = line.strip()
            if line.startswith("signal:"):
                out["rssi"] = line.split(":", 1)[1].strip().split(" ")[0]
    except Exception:  # noqa: BLE001
        pass
    try:
        for name in os.listdir("/sys/class/net"):
            if name.startswith("wlx"):
                with open("/sys/class/net/%s/operstate" % name) as f:
                    out["usb"] = f.read().strip()
                break
    except Exception:  # noqa: BLE001
        pass
    return out


def find_usb_devices(ids):
    """Return sysfs device names whose idVendor:idProduct is in ids."""
    found = []
    base = "/sys/bus/usb/devices"
    for name in sorted(os.listdir(base)):
        try:
            with open(os.path.join(base, name, "idVendor")) as f:
                vid = f.read().strip()
            with open(os.path.join(base, name, "idProduct")) as f:
                pid = f.read().strip()
        except OSError:
            continue
        if "%s:%s" % (vid, pid) in ids:
            found.append(name)
    return found


def usb_rebind(ids):
    names = find_usb_devices(ids)
    if not names:
        raise Refused("device not present")
    done = []
    for name in names:
        with open("/sys/bus/usb/drivers/usb/unbind", "w") as f:
            f.write(name)
        time.sleep(1.0)
        with open("/sys/bus/usb/drivers/usb/bind", "w") as f:
            f.write(name)
        done.append(name)
    return {"rebound": done}


def parse_usb_name(name):
    """'2-1.3' -> ('2-1', 3). A root-port device such as '2-2' is refused:
    on the Pi 5 the four root ports share one VBUS group, so cutting one
    would drop every device."""
    name = str(name or "")
    if not USB_NAME_RE.match(name):
        raise Refused("bad usb device name")
    if "." not in name:
        raise Refused("device is on a root port, not switchable")
    hub, port = name.rsplit(".", 1)
    return hub, int(port)


def read_vidpid(name):
    try:
        with open(os.path.join(USB_SYSFS, name, "idVendor")) as f:
            vid = f.read().strip()
        with open(os.path.join(USB_SYSFS, name, "idProduct")) as f:
            pid = f.read().strip()
    except OSError:
        return None
    return "%s:%s" % (vid, pid)


def twin_hub(hub):
    """The other-speed twin of a hub path ('2-1' -> '3-1'): same port path
    under the root hub that shares the same host controller. A USB 3 hub
    enumerates as two virtual hubs and uhubctl must switch both. None when
    the hub has no twin."""
    bus, _sep, rest = str(hub).partition("-")
    try:
        parent = os.path.realpath(os.path.join(USB_SYSFS, "usb" + bus, ".."))
        names = os.listdir(USB_SYSFS)
    except OSError:
        return None
    for name in sorted(names):
        other = name[3:] if name.startswith("usb") else ""
        if not other.isdigit() or other == bus:
            continue
        if os.path.realpath(os.path.join(USB_SYSFS, name, "..")) != parent:
            continue
        cand = "%s-%s" % (other, rest)
        if os.path.isdir(os.path.join(USB_SYSFS, cand)):
            return cand
    return None


def usb_name_for_tty(tty):
    """'/dev/ttyACM1' -> the sysfs USB device name it hangs off ('2-1.3')."""
    n = os.path.basename(str(tty or ""))
    if not re.match(r"^tty[A-Za-z]+\d+$", n):
        raise Refused("bad tty")
    path = os.path.realpath("/sys/class/tty/%s/device" % n)
    for part in reversed(path.split("/")):
        if USB_NAME_RE.match(part) and os.path.exists(os.path.join(USB_SYSFS, part, "idVendor")):
            return part
    raise Refused("tty is not a usb device")


def resolve_usb_port(role, tty=None):
    """Locate a role's device on the bus and return its hub, twin hub and
    port. Raises Refused for an unknown role, an absent or ambiguous device,
    a tty that is not that device, or a root port."""
    ids = USB_DEVICES.get(str(role or ""))
    if ids is None:
        raise Refused("device not allowed")
    if tty:
        name = usb_name_for_tty(tty)
        vidpid = read_vidpid(name)
        if vidpid not in ids:
            raise Refused("tty is not a %s device" % role)
    else:
        names = find_usb_devices(ids)
        if not names:
            raise Refused("device not present")
        if len(names) > 1:
            raise Refused("ambiguous, pass tty")
        name = names[0]
        vidpid = read_vidpid(name)
    hub, port = parse_usb_name(name)
    return {"name": name, "vidpid": vidpid, "hub": hub, "twin": twin_hub(hub), "port": port}


def hub_switchable(hub, port):
    """True when uhubctl accepts the hub as one with per-port power switching.
    A ganged hub answers 'No compatible devices detected'. The location is
    matched exactly (-e): with the default prefix match uhubctl 2.5 refuses
    the USB 3 half of a dual hub (VIA VL817: '-l 3-1' answers 'No compatible
    devices', '-l 3-1 -e' works), so without -e the twin was never switched
    and a real VBUS cut on that hub needs both halves off. [MESHSAT-786]"""
    try:
        p = run_argv(["uhubctl", "-l", str(hub), "-e", "-p", str(port)], 10)
    except (OSError, subprocess.TimeoutExpired):
        return False
    out = (p.stdout or "") + (p.stderr or "")
    return p.returncode == 0 and "Current status for hub" in out and "No compatible devices" not in out


def usb_switchable(roles, tty=None):
    """Per role: where the device sits and whether its port can be power-cycled."""
    out = {}
    for role in roles:
        try:
            dev = resolve_usb_port(role, tty)
            dev["switchable"] = hub_switchable(dev["hub"], dev["port"])
            out[role] = dev
        except Refused as e:
            out[role] = {"switchable": False, "reason": str(e)}
    return out


def usb_cycle_main(argv):
    """Detached helper: `--usb-cycle <port> <off_ms> <hub> [<twin>]`.
    Runs under a transient systemd unit started by the agent."""
    if len(argv) < 3:
        log("usb-cycle: usage: --usb-cycle <port> <off_ms> <hub> [<twin>]")
        return 2
    try:
        port = int(argv[0])
    except ValueError:
        port = 0
    off_ms = clamp(argv[1], MIN_OFF_MS, MAX_OFF_MS, DEFAULT_OFF_MS)
    hubs = [h for h in argv[2:] if USB_NAME_RE.match(h) or h.isdigit()]
    if not 1 <= port <= 64 or not hubs or len(hubs) != len(argv[2:]):
        log("usb-cycle: bad arguments %r" % (argv,))
        return 2

    def switch(hub, state):
        try:
            p = run_argv(["uhubctl", "-l", hub, "-e", "-p", str(port), "-a", state], 15)
            code = p.returncode
        except (OSError, subprocess.TimeoutExpired) as e:
            log("usb-cycle: uhubctl %s: %s" % (state, e))
            code = 1
        log("usb-cycle: %s port %d %s rc=%d" % (hub, port, state, code))
        return code

    rc = 0
    for h in hubs:
        rc |= switch(h, "off")
    time.sleep(off_ms / 1000.0)
    for h in hubs:
        code = switch(h, "on")
        if code != 0:
            time.sleep(1.0)
            code = switch(h, "on")
        rc |= code
    return 1 if rc else 0


def dispatch(request):
    action = str(request.get("action", ""))
    args = request.get("args") or {}
    if not isinstance(args, dict):
        return {"ok": False, "error": "args must be an object"}
    started = time.time()
    try:
        argv, timeout, post = plan(action, args)
        proc = None
        if argv is not None:
            proc = run_argv(argv, timeout)
            if proc.returncode != 0:
                err = (proc.stderr or proc.stdout or "").strip()[:120]
                log("%s args=%s rc=%d %.2fs err=%s" % (action, json.dumps(args), proc.returncode, time.time() - started, err))
                return {"ok": False, "error": "rc=%d %s" % (proc.returncode, err), "version": VERSION}
        result = post(proc)
        log("%s args=%s rc=0 %.2fs" % (action, json.dumps(args), time.time() - started))
        return {"ok": True, "result": result, "version": VERSION}
    except Refused as e:
        log("%s args=%s refused: %s" % (action, json.dumps(args), e))
        return {"ok": False, "error": str(e), "version": VERSION}
    except subprocess.TimeoutExpired:
        log("%s timed out" % action)
        return {"ok": False, "error": "timeout", "version": VERSION}
    except Exception as e:  # noqa: BLE001
        log("%s failed: %s" % (action, e))
        return {"ok": False, "error": str(e)[:120], "version": VERSION}


def handle(conn):
    conn.settimeout(READ_TIMEOUT)
    try:
        data = b""
        while b"\n" not in data and len(data) < MAX_LINE:
            chunk = conn.recv(1024)
            if not chunk:
                break
            data += chunk
        line = data.split(b"\n", 1)[0].strip()
        if not line:
            return
        try:
            request = json.loads(line.decode("utf-8"))
        except ValueError:
            reply = {"ok": False, "error": "invalid json", "version": VERSION}
        else:
            reply = dispatch(request if isinstance(request, dict) else {})
        conn.sendall((json.dumps(reply) + "\n").encode("utf-8"))
    except socket.timeout:
        pass
    finally:
        try:
            conn.close()
        except OSError:
            pass


def listen_socket():
    """Socket activation (fd 3) when started by systemd, else bind ourselves."""
    if os.environ.get("LISTEN_FDS") == "1":
        return socket.socket(fileno=3, family=socket.AF_UNIX, type=socket.SOCK_STREAM)
    d = os.path.dirname(SOCKET_PATH)
    os.makedirs(d, mode=0o750, exist_ok=True)
    try:
        os.unlink(SOCKET_PATH)
    except FileNotFoundError:
        pass
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.bind(SOCKET_PATH)
    os.chmod(SOCKET_PATH, 0o660)
    s.listen(4)
    return s


def main():
    s = listen_socket()
    log("listening on %s (version %s)" % (SOCKET_PATH, VERSION))
    while True:
        try:
            conn, _ = s.accept()
        except OSError as e:
            log("accept: %s" % e)
            time.sleep(0.5)
            continue
        handle(conn)


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--usb-cycle":
        sys.exit(usb_cycle_main(sys.argv[2:]))
    sys.exit(main())
