[Unit]
Description=Rebind Goodix-TS (Pi Touch Display 2) when its probe lost the attiny race or misread its config
After=systemd-udev-settle.service multi-user.target
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 10
ExecStart=/usr/local/bin/meshsat-goodix-rebind
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
