# labwc autostart — runs once labwc is ready.
# [MESHSAT-578 / kiosk session]
#
# Template variables substituted by scripts/install-kiosk.sh:
#   __BRIDGE_URL__  → the kiosk URL
#
# Output rotation via wlr-randr (labwc rc.xml 0.7 has no rotate
# element; wlr-randr uses wlr_output_management_v1 which labwc
# implements).

# 1. Output rotation — DSI-2 270° (native portrait → landscape).
#    Both V1 kits carry the panel flipped 180° relative to the
#    original 2026-04 build (cable side flipped, tesseract 2026-04-24,
#    parallax later), and both boot with `display_lcd_rotate=2` in
#    config.txt. 270 here and the matching `0 1 0 -1 0 1` matrix in
#    99-touch-rotate.rules are what both kits actually run — verified
#    live on tesseract and parallax 2026-09-08. The 90 / `0 -1 1 1 0 0`
#    pair this file shipped until then would have flipped both panels
#    upside down on the next installer run. [MESHSAT-987]
wlr-randr --output DSI-2 --transform 270 &

# 2. Wait for the bridge container to be healthy before launching
#    Chromium. Otherwise the browser boots faster than docker and
#    shows "site can't be reached" until the next manual reload.
#    Poll the bridge's /health endpoint every second; bail out after
#    5 minutes with a soft launch so the screen isn't black forever in
#    a genuinely broken deploy. Chromium does NOT retry on its own: a
#    soft-launched kiosk sits on "site can't be reached" until someone
#    relaunches it (both kits, 9 Sep 2026, an hour with no bridge
#    behind a live browser). So a soft launch also arms a watcher that
#    keeps polling and relaunches Chromium once the bridge answers.
#    [MESHSAT-994]
BRIDGE_HEALTH_URL="http://localhost:6050/health"
BRIDGE_WAIT_MAX=300   # 5 minutes

bridge_healthy() {
  curl -fsS --max-time 2 "$BRIDGE_HEALTH_URL" >/dev/null 2>&1
}

i=0
while [ "$i" -lt "$BRIDGE_WAIT_MAX" ]; do
  if bridge_healthy; then
    break
  fi
  sleep 1
  i=$((i + 1))
done
BRIDGE_SOFT_LAUNCH=0
[ "$i" -ge "$BRIDGE_WAIT_MAX" ] && BRIDGE_SOFT_LAUNCH=1

# 3. Idle backlight dim — swayidle hooks labwc's idle notifier and
#    dims the panel to 32/255 after 10 min of no input, restores to
#    200/255 on activity. The backlight write is delegated to a
#    sudoers-scoped wrapper (/usr/local/bin/meshsat-backlight),
#    installed with a one-command sudoers entry so the kiosk user
#    can't reach anything else under /sys. [MESHSAT-580]
#    `--idle` makes the dim conditional: on mains power (X1202
#    ac_present) the panel never dims. [MESHSAT-827]
swayidle -w \
  timeout 600 'sudo -n /usr/local/bin/meshsat-backlight --idle 32' \
  resume 'sudo -n /usr/local/bin/meshsat-backlight 200' &

# 4. Chromium kiosk — policy lockdown in
#    /etc/chromium/policies/managed/meshsat-kiosk.json.
#    --force-device-scale-factor=1.5 scales CSS pixels to make the
#    UI readable on the 7" DSI panel (1280×720 native → 853×480
#    logical).  --enable-use-zoom-for-dsf=true is required alongside
#    it so Chromium implements the scale via CSS zoom rather than
#    direct viewport scaling — otherwise touch coordinates stay
#    unscaled and every tap lands in the wrong spot. Verified live
#    on tesseract 2026-04-19. [MESHSAT-549/578]
# Long-running kiosk resilience flags [MESHSAT-628]:
# Chromium's default backgrounding heuristics throttle setInterval
# handlers + lazy-GC even in foreground kiosk mode after long
# uptimes — observed on tesseract 2026-04-20 as "info out of date
# + clicks don't register" after 10 h (scroll still worked because
# it's GPU-composited, independent of the main JS thread). These
# flags plus a bounded V8 heap make polling + click dispatch
# latency deterministic over multi-day uptimes.
# --ozone-platform=wayland names the backend explicitly instead of
# letting Chromium auto-detect it; --user-data-dir keeps the kiosk
# profile in one known place rather than the snap's default, so a
# wedged profile can be cleared without touching the snap. The log
# keeps one previous generation, so the session that wedged is still
# readable after the nightly restart timer has relaunched Chromium.
# [MESHSAT-987]
KIOSK_LOG="/home/kiosk/.cache/chromium-kiosk.log"

launch_chromium() {
mkdir -p "$(dirname "$KIOSK_LOG")"
[ -f "$KIOSK_LOG" ] && mv -f "$KIOSK_LOG" "$KIOSK_LOG.1"

chromium-browser \
  --ozone-platform=wayland \
  --user-data-dir=/home/kiosk/kiosk-profile \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --disable-translate \
  --no-first-run \
  --no-default-browser-check \
  --start-fullscreen \
  --touch-events=enabled \
  --force-device-scale-factor=1.5 \
  --enable-use-zoom-for-dsf=true \
  --disable-background-timer-throttling \
  --disable-renderer-backgrounding \
  --disable-backgrounding-occluded-windows \
  --disable-features=CalculateNativeWinOcclusion,BackForwardCache \
  --js-flags="--max-old-space-size=256" \
  --app="__BRIDGE_URL__" >"$KIOSK_LOG" 2>&1 &
}
# NB: the URL MUST be quoted — it contains `&` (query-string
# separator between kiosk=1 and shell=operator). Without quotes,
# bash parses the unquoted `&` as job-control and drops everything
# after it, so Chromium would load only `?kiosk=1` and silently
# ignore the `shell=…` role param. Verified on tesseract
# 2026-04-19: bug dropped the role selector, bringing up the
# wrong nav surface. [MESHSAT-549]

launch_chromium

# 5. Soft-launch watcher [MESHSAT-994]: the bridge was not healthy when
#    Chromium started (a deploy still pulling, or a container left in
#    the exited state by a scripted poweroff), so the kiosk is showing
#    an error page. Keep polling; once /health answers, replace the
#    browser with a fresh one pointed at the live bridge. The snap's
#    processes are named "chrome", not "chromium"; exact-name match
#    only, never -f, which could match this shell's own command line.
if [ "$BRIDGE_SOFT_LAUNCH" = "1" ]; then
  (
    until bridge_healthy; do sleep 5; done
    sleep 3
    pkill -u kiosk -x chrome 2>/dev/null || true
    sleep 2
    launch_chromium
  ) &
fi
